# ---------------------------------------------------------------------------
# PDFSafe environment overrides.
#
# The DESKTOP APPLICATION does not need this file. It reads its settings from
# %APPDATA%\PDFSafe\config.json (written by the settings dialog) and its API key
# from Windows Credential Manager. Everything below is for development and for
# the optional server deployment.
#
# Every key maps to a field on pdfsafe.config.Settings (prefix PDFSAFE_).
# Precedence: environment > config.json > this file > defaults.
# ---------------------------------------------------------------------------

# --- application ---
PDFSAFE_ENV=development                 # desktop | development | staging | production | test
PDFSAFE_DEBUG=true
PDFSAFE_LOG_LEVEL=INFO
PDFSAFE_LOG_JSON=false

# --- analysis ---
PDFSAFE_ANALYSIS_WORKERS=2
PDFSAFE_ANALYSIS_TIMEOUT_SECONDS=60
PDFSAFE_ANALYSIS_ISOLATION=process      # process (sandboxed) | in_process (faster)
PDFSAFE_ENABLE_YARA=true
PDFSAFE_YARA_RULES_DIR=                 # empty -> bundled rules
PDFSAFE_MAX_UPLOAD_BYTES=104857600      # 100 MiB
PDFSAFE_QUARANTINE_ENABLED=true
PDFSAFE_KEEP_SCANNED_COPIES=true

# --- AI triage (optional; heuristics run regardless) ---
# The LLM is consulted only for files scoring between the two thresholds.
PDFSAFE_AI_ENABLED=false
PDFSAFE_AI_PROVIDER=anthropic           # anthropic | custom | null
PDFSAFE_AI_ESCALATE_MIN_SCORE=25        # below -> decided locally, no API call
PDFSAFE_AI_ESCALATE_MAX_SCORE=85        # at/above -> decided locally, no API call
PDFSAFE_AI_ALWAYS_ESCALATE=false
PDFSAFE_AI_SHARE_TEXT_EXCERPT=true
PDFSAFE_AI_MAX_EVIDENCE_CHARS=24000
PDFSAFE_AI_TIMEOUT_SECONDS=60
PDFSAFE_AI_DAILY_TOKEN_BUDGET=0         # 0 = unlimited

# In the desktop build the key comes from Credential Manager; this is a
# development fallback only. Never commit a real key.
PDFSAFE_ANTHROPIC_API_KEY=
PDFSAFE_ANTHROPIC_MODEL=claude-sonnet-5
PDFSAFE_ANTHROPIC_MAX_TOKENS=2048

# Bring-your-own OpenAI-compatible endpoint
PDFSAFE_CUSTOM_AI_BASE_URL=
PDFSAFE_CUSTOM_AI_API_KEY=
PDFSAFE_CUSTOM_AI_MODEL=

# --- watched folders ---
PDFSAFE_WATCH_ENABLED=false
PDFSAFE_WATCH_FOLDERS=                  # comma separated
PDFSAFE_WATCH_POLL_SECONDS=15
PDFSAFE_WATCH_RECURSIVE=false

# --- updates ---
PDFSAFE_UPDATE_CHECK_ENABLED=true
PDFSAFE_UPDATE_FEED_URL=https://updates.pdfsafe.app/desktop/latest.json
PDFSAFE_UPDATE_CHANNEL=stable

# --- storage / database ---
# Empty database_url -> SQLite under %LOCALAPPDATA%\PDFSafe.
PDFSAFE_DATABASE_URL=
PDFSAFE_STORAGE_BACKEND=local           # local | s3
PDFSAFE_STORAGE_LOCAL_PATH=

# ===========================================================================
# Server deployment only (pip install '.[server]')
# ===========================================================================
# PDFSAFE_ENV=production
# PDFSAFE_SECRET_KEY=change-me-to-a-long-random-string
# PDFSAFE_API_KEYS=key-one,key-two
# PDFSAFE_DATABASE_URL=postgresql+asyncpg://pdfsafe:pdfsafe@localhost:5432/pdfsafe
# PDFSAFE_REDIS_URL=redis://localhost:6379/0
# PDFSAFE_CELERY_BROKER_URL=redis://localhost:6379/1
# PDFSAFE_CELERY_RESULT_BACKEND=redis://localhost:6379/2
# PDFSAFE_CORS_ORIGINS=http://localhost:3000
# PDFSAFE_RATE_LIMIT_PER_MINUTE=60
# PDFSAFE_METRICS_ENABLED=true
# PDFSAFE_S3_BUCKET=
# PDFSAFE_S3_ENDPOINT_URL=
# PDFSAFE_S3_REGION=us-east-1
# PDFSAFE_S3_ACCESS_KEY_ID=
# PDFSAFE_S3_SECRET_ACCESS_KEY=
